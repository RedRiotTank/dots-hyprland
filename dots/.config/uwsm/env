# Shared defaults installed by the fork. Put machine-specific or personal
# overrides in ~/.config/uwsm/env.local, which the installer leaves untouched.
export BROWSER=firefox
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# If you have an NVIDIA GPU uncomment the following lines
# export GBM_BACKEND=nvidia-drm # force GBM as a backend
# export __GLX_VENDOR_LIBRARY_NAME=nvidia # force GBM as a backend
# export LIBVA_DRIVER_NAME=nvidia # Hardware acceleration on NVIDIA GPUs
# export __GL_GSYNC_ALLOWED=1 # Controls if G-Sync capable monitors should use Variable Refresh Rate (VRR)

# Multi-GPU / hybrid graphics workaround. If Hyprland aborts while
# initializing the DRM/EGL backend on a multi-GPU system, uncomment and adapt
# these values to the card order reported by `ls /dev/dri`. Aquamarine reads
# them before Hyprland loads its config, so they belong here instead of
# custom/env.lua.
# export AQ_MGPU_NO_EXPLICIT=1
# export AQ_DRM_DEVICES="/dev/dri/card1:/dev/dri/card0"
# export AQ_NO_MODIFIERS=1
